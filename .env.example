# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in your real values.
#  .env is gitignored and never committed.
#  docker-compose.prod.yml reads these automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=dodo
DB_USER=dodo
DB_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── URLs ──────────────────────────────────────────────────────────────────────
# Frontend origin for CORS — your GitHub Pages URL
FRONTEND_URL=https://yourusername.github.io
# Backend public URL — used in email links
APP_URL=https://your-backend-domain.com

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Seeding ───────────────────────────────────────────────────────────────────
# Set to true on first boot to load demo data, then set back to false
SEED_DB=false

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV ONLY (not used by docker-compose.prod.yml)
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://tasknest:tasknest@localhost:5321/tasknest
# PORT=3000
# NODE_ENV=development
