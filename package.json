{
  "name": "tasknest-backend",
  "version": "1.0.0",
  "description": "TaskNest backend API with Express + Prisma",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
